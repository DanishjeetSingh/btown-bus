[Unit]
Description=B-Town Bus tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/u/singhdan/btown-bus
Environment=NODE_ENV=production
Environment=PATH=/u/singhdan/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/u/singhdan/.local/bin/npm run start -- --port 3100 --hostname 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
